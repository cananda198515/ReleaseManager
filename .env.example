# Environment template (Implementation Guide v2.0, section 9.1). Copy to .env for local use; .env is git-ignored.
# Secrets are placeholders only: in deployed environments they are resolved from the secret provider by name.
APP_ENV=dev
API_BASE_URL=https://release-api-dev.example.com
MYSQL_HOST=<private-host>
MYSQL_PORT=3306
MYSQL_DATABASE=release_management
MYSQL_USER=release_api
MYSQL_PASSWORD=<resolved-from-secret-manager>
# Migration identity (Alembic only; DDL privileges). Never used by the Release API runtime (NFR-06).
MIGRATION_MYSQL_USER=release_migrator
MIGRATION_MYSQL_PASSWORD=<resolved-from-secret-manager>
# Disposable database for tests/integration (name must end in _test; tests drop and clear its tables).
MYSQL_TEST_DATABASE=release_management_test
MCP_PUBLIC_URL=https://release-mcp-dev.example.com/mcp
OUTLOOK_MAILBOX=release.automation@example.com
JIRA_BASE_URL=https://<tenant>.atlassian.net
CONFLUENCE_BASE_URL=https://<tenant>.atlassian.net/wiki
SECRET_PROVIDER=azure-key-vault
LOG_LEVEL=INFO
